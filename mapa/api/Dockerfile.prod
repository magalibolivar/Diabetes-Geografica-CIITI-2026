FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PATH="/app/.venv/bin:$PATH"

RUN pip install --no-cache-dir uv
WORKDIR /app

COPY mapa/api/pyproject.toml mapa/api/uv.lock mapa/api/.python-version ./
RUN uv sync --frozen --no-dev --no-install-project

COPY mapa/api/alembic.ini ./
COPY mapa/api/migrations ./migrations
COPY mapa/api/src ./src
RUN uv sync --frozen --no-dev

# Insumos públicos agregados, versionados con el código. El ETL ya no monta
# archivos del checkout efímero que Dokploy reemplaza en cada despliegue.
COPY data/cuadros_definitivos_enfr_2018.xls /sources/data/cuadros_definitivos_enfr_2018.xls
COPY data/processed/enfr2018_provincias.csv /sources/data/processed/enfr2018_provincias.csv
COPY data/processed/nbi_2022_hogares.csv /sources/data/processed/nbi_2022_hogares.csv
COPY mapa/data/geo/argentina_provincias.geojson /sources/geo/argentina_provincias.geojson

RUN useradd --system --no-create-home app
USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2).status == 200 else 1)"

CMD ["uvicorn", "mapa.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
