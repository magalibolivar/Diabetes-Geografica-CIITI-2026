# Copiar a .env (no se versiona). En Dokploy se cargan como variables de entorno del servicio.
POSTGRES_USER=mapa
POSTGRES_PASSWORD=cambiar-esto
POSTGRES_DB=mapa

# API
MAPA_ENVIRONMENT=dev            # dev | prod  (en prod se apaga /docs y el comando bootstrap)

# Sitio web: clave de sólo lectura para que el servidor consulte la API.
#   docker compose run --rm etl keys create --name web --scope read
MAPA_WEB_API_KEY=
# URL pública del sitio (detrás de Traefik/Dokploy: https://tu-dominio)
MAPA_PUBLIC_ORIGIN=http://localhost:3000
